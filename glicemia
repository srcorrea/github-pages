import streamlit as st
import pandas as pd
import matplotlib.pyplot as plt
import sqlite3
from fpdf import FPDF
from datetime import datetime
import io

st.set_page_config(layout="wide", page_title="Login - Controle Glicemia")

# Estilo personalizado
theme_css = """
<style>
    .stTextInput > div > div > input {
        font-size: 16px;
        padding: 10px;
    }
    .stButton button {
